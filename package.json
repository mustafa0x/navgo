{
	"name": "navgo",
	"version": "6.0.13-beta.7",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mustafa0x/navgo.git"
	},
	"description": "Adavanced router",
	"module": "./index.js",
	"type": "module",
	"exports": "./index.js",
	"types": "index.d.ts",
	"license": "MIT",
	"author": {
		"name": "mustafa j"
	},
	"scripts": {
		"build": "perl -0777 -i -pe 's/console.debug\\(...args\\)/{}/g' index.js",
		"prepublishOnly": "npm run build",
		"test": "vitest run index.test.js",
		"test:e2e": "playwright test --project=chromium",
		"start:testsite": "pnpm vite dev test/site --port 5714",
		"types": "tsc -p test/types",
		"format": "oxfmt -c .oxfmtrc.json .",
		"format:check": "oxfmt --check -c .oxfmtrc.json .",
		"lint": "oxlint -c oxlint.config.js .",
		"lint:fix": "oxlint --fix -c oxlint.config.js ."
	},
	"files": [
		"*.d.ts",
		"index.js",
		"utils.js",
		"llms.txt",
		"changelog.md",
		"readme.md"
	],
	"keywords": [
		"browser",
		"client-side",
		"router"
	],
	"dependencies": {
		"es-toolkit": "^1.49.0",
		"regexparam": "^3.0.0",
		"valibot": "^1.4.2"
	},
	"peerDependencies": {
		"svelte": "5"
	},
	"devDependencies": {
		"@playwright/test": "^1.61.1",
		"@mustafaj/oxfmt": "0.58.0-svelte.6",
		"@mustafaj/oxlint": "1.73.0-svelte.9",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.2",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "^26.1.1",
		"globals": "^17.7.0",
		"jiti": "^2.7.0",
		"lightningcss": "^1.32.0",
		"svelte": "^5.56.4",
		"tailwindcss": "^4.3.2",
		"terser": "5.49.0",
		"typescript": "5.9.3",
		"vite": "^8.1.4",
		"vitest": "^4.1.10"
	}
}
