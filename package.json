{
	"name": "navgo",
	"version": "6.0.13-beta.3",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mustafa0x/navgo.git"
	},
	"description": "Adavanced router",
	"module": "./index.js",
	"type": "module",
	"exports": "./index.js",
	"types": "index.d.ts",
	"license": "MIT",
	"author": {
		"name": "mustafa j"
	},
	"scripts": {
		"build": "perl -0777 -i -pe 's/console.debug\\(...args\\)/{}/g' index.js",
		"prepublishOnly": "pnpm run build",
		"test": "vitest run index.test.js",
		"test:e2e": "playwright test --project=chromium",
		"start:testsite": "pnpm vite dev test/site --port 5714",
		"types": "tsc -p test/types"
	},
	"files": [
		"*.d.ts",
		"index.js",
		"utils.js",
		"llms.txt",
		"changelog.md",
		"readme.md"
	],
	"keywords": [
		"browser",
		"client-side",
		"router"
	],
	"dependencies": {
		"es-toolkit": "^1.49.0",
		"regexparam": "^3.0.0",
		"valibot": "^1.4.2"
	},
	"peerDependencies": {
		"svelte": "5"
	},
	"devDependencies": {
		"@eslint/js": "^9.37.0",
		"@playwright/test": "^1.61.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.2",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "^26.1.1",
		"eslint": "^9.37.0",
		"eslint-plugin-svelte": "^3.20.0",
		"globals": "^17.7.0",
		"jiti": "^2.7.0",
		"lightningcss": "^1.32.0",
		"prettier": "^3.9.5",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.4",
		"tailwindcss": "^4.3.2",
		"terser": "5.49.0",
		"typescript": "5.9.3",
		"typescript-eslint": "^8.63.0",
		"vite": "^8.1.4",
		"vitest": "^4.1.10"
	},
	"prettier": {
		"semi": false,
		"singleQuote": true,
		"tabWidth": 4,
		"printWidth": 100,
		"quoteProps": "as-needed",
		"bracketSpacing": true,
		"arrowParens": "avoid",
		"useTabs": true,
		"overrides": [
			{
				"files": "*.md",
				"options": {
					"tabWidth": 2,
					"useTabs": false
				}
			}
		]
	}
}
